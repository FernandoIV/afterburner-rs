[Desktop Entry]
Type=Application
Version=1.0
Name=Afterburner RS Monitor
GenericName=GPU TUI Monitor
Comment=Live hardware monitor in the terminal (MSI Afterburner port)
Exec=/usr/local/bin/afterburner-rs tui
TryExec=/usr/local/bin/afterburner-rs
Icon=afterburner-rs
Terminal=true
Categories=System;Monitor;TerminalEmulator;
Keywords=GPU;monitor;temperature;afterburner;MSI;
StartupNotify=false
