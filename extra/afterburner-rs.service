# afterburner-rs — servicio systemd (usuario o sistema)
# Instalación:
#   sudo cp extra/afterburner-rs.service /etc/systemd/system/
#   sudo cp target/release/afterburner-rs /usr/local/bin/
#   sudo systemctl enable --now afterburner-rs
#
# El daemon publica /dev/shm/MAHMSharedMemory (formato MAHM v2.0) y sirve
# /dev/shm/MACMSharedMemory (control), permitiendo que cualquier herramienta
# compatible con la interfaz de MSI Afterburner consuma los datos de
# hardware en Linux.

[Unit]
Description=afterburner-rs: hardware monitoring/overclocking (MSI Afterburner port)
Documentation=man:afterburner-rs(1)
After=multi-user.target graphical.target

[Service]
Type=simple
# Corre como el usuario de escritorio para compartir ajustes y perfiles con
# la CLI (~/HOME/.config/afterburner-rs). La GPU se controla con nvidia-smi,
# que no requiere X.
User=ironcoder
Environment=HOME=/home/ironcoder
ExecStart=/usr/local/bin/afterburner-rs daemon --period 1000
Restart=on-failure
RestartSec=3
Nice=-5

[Install]
WantedBy=multi-user.target
