[Desktop Entry]
Type=Application
Version=1.0
Name=Afterburner RS
GenericName=GPU Monitor & Overclock
Comment=Native GTK4 control center for clocks, power, fans and sensors
Exec=/usr/local/bin/afterburner-rs gui
TryExec=/usr/local/bin/afterburner-rs
Icon=afterburner-rs
Terminal=false
Categories=System;Monitor;
Keywords=GPU;overclock;fan;temperature;afterburner;MSI;
StartupNotify=true
StartupWMClass=io.github.afterburnerrs.Native
